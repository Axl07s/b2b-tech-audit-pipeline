# ─────────────────────────────────────────────
# Google APIs
# ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE
# PageSpeed Insights uses same key (or leave blank to use unauthenticated — 25 req/day)
GOOGLE_PAGESPEED_API_KEY=YOUR_GOOGLE_PLACES_API_KEY_HERE

# ─────────────────────────────────────────────
# LLM Provider  (pick ONE and fill it)
# ─────────────────────────────────────────────
LLM_PROVIDER=ollama          # options: ollama | openai | anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-3-5

# ─────────────────────────────────────────────
# SMTP — outgoing mail
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.outreach@yourdomain.com
SMTP_PASSWORD=YOUR_APP_PASSWORD_HERE
# Hard ceiling per day across ALL targets
MAX_DAILY_EMAILS=25

# ─────────────────────────────────────────────
# IMAP — reply listener
# ─────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.outreach@yourdomain.com
IMAP_PASSWORD=YOUR_APP_PASSWORD_HERE

# ─────────────────────────────────────────────
# Alert routing (pick ONE or both)
# ─────────────────────────────────────────────
ALERT_EMAIL=your.personal@email.com          # forwarding alert
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ─────────────────────────────────────────────
# Pipeline tuning
# ─────────────────────────────────────────────
# Minimum delay between emails in seconds (uniform random in [MIN, MAX])
SEND_DELAY_MIN=300
SEND_DELAY_MAX=720
# Follow-up windows in calendar days
FOLLOWUP_DAY2=3
FOLLOWUP_DAY3=7
# Dry-run flag (true = never actually send; false = live)
DRY_RUN=true
